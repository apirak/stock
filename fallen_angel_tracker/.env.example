# ===========================================================================
# Fallen Angel Tracker — copy to `.env` and fill in what you use.
# Everything is optional; unset subsystems degrade gracefully:
#   - no Discord/email -> weekly digest saved to reports/ instead of sent
# Storage is always local: data/daily_log.csv + reports/*.md
# Analysis is performed by the ZCode harness (see ai-node/), never by a
# paid LLM API — there are intentionally no LLM keys in this project.
# ===========================================================================

# --- Email via Gmail SMTP (use a 16-char App Password, NOT your login pwd) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=you@gmail.com
# comma-separated recipients
EMAIL_TO=

# --- Discord webhooks (daily summary + weekly digest channels) ---------------
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
# Treat as secrets — anyone holding a URL can post to the channel
# Channel for the DAILY summary (posted after --mode finalize)
DISCORD_WEBHOOK_URL=
# Channel for the WEEKLY digest (3-message format); falls back to the daily
# webhook above when left empty
DISCORD_WEBHOOK_URL_WEEKLY=
# (optional) override display name per message; leave empty to use the
# webhook's own name/avatar configured in Discord
DISCORD_USERNAME=

# --- Stock universe ----------------------------------------------------------
# Curated wide-moat candidates (the "scan" input); override freely
WATCHLIST=UNH,TGT,DIS,PYPL,SBUX,NKE,BA,ADM
# Manual Morningstar-style fair values: TICKER=price,TICKER=price
FAIR_VALUE_OVERRIDES=

# --- Optional framework tuning (defaults shown) ------------------------------
# RISK_FREE_RATE=0.042
# EQUITY_RISK_PREMIUM=0.05
# MAX_NET_DEBT_EBITDA / MIN_INTEREST_COVERAGE / MIN_DISCOUNT_FOR_BUY are
# constants in config.py (3.0x / 5.0x / 15%)
